meta {
  name: Health Check
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}
tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("body has status ok", function() {
    expect(res.getBody().status).to.equal("ok");
  });
}
