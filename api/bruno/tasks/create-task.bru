meta {
  name: Create Task
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/api/v1/tasks
  body: json
  auth: none
}
body:json {
  {
    "title": "Fix the login bug",
    "description": "Users cannot log in on mobile"
  }
}
tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("task has an id", function() {
    expect(res.getBody().id).to.be.a("number");
  });
  test("status defaults to todo", function() {
    expect(res.getBody().status).to.equal("todo");
  });
}
